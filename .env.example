# Dog API v2 requires NO API key or auth token.
# These variables exist only so the base URL and network tuning can be changed
# without a code edit (e.g. pointing at a mock server during testing).
# The app ships with working defaults, so copying this file is optional.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the JS bundle.

# Base URL for the Dog API v2.
EXPO_PUBLIC_DOG_API_BASE_URL=https://dogapi.dog/api/v2

# Per-request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Number of retry attempts for transient failures (exponential backoff).
EXPO_PUBLIC_API_MAX_RETRIES=3

# Records requested per page. The API default is 30; 48 yields 6 pages for 283 breeds.
EXPO_PUBLIC_API_PAGE_SIZE=48
